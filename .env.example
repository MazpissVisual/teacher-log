# Salin ke .env lalu isi dari Supabase: Settings -> API Keys
# Hanya dua nilai ini yang dipakai. Jangan masukkan secret / service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Opsional: kunci publik VAPID untuk notifikasi saat aplikasi tertutup (lihat supabase/push-setup.md)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...

# Opsional: alamat kontak yang tampil di halaman Kebijakan Privasi dan Syarat
# NEXT_PUBLIC_CONTACT_EMAIL=halo@contoh.id
